{
  "name": "@cookiemunch/sdk",
  "version": "0.4.1",
  "description": "Typed REST client for the Cookie Munch Developer API (/v1)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./consent": {
      "types": "./dist/consent.d.ts",
      "import": "./dist/consent.js",
      "require": "./dist/consent.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cookie-Munch/sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "homepage": "https://cookiemunch.net/docs",
  "bugs": {
    "url": "https://github.com/Cookie-Munch/sdk/issues"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
